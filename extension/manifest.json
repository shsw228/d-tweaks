{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "ja",
  "version": "1.3.0",
  "description": "__MSG_appDesc__",
  "permissions": [
    "scripting",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://animestore.docomo.ne.jp/*",
    "https://*.nicovideo.jp/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "csp", "enabled": false, "path": "rules.json" },
      { "id": "nico-ua", "enabled": false, "path": "rules-nico.json" }
    ]
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://animestore.docomo.ne.jp/animestore/*"],
      "exclude_matches": [
        "https://animestore.docomo.ne.jp/animestore/book/*",
        "https://animestore.docomo.ne.jp/animestore/ec/*"
      ],
      "js": ["pkg/core.js", "wasm-loader.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pkg/core_bg.wasm"],
      "matches": ["https://animestore.docomo.ne.jp/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
